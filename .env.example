# ─────────────────────────────────────────────────────────────
# RoutineFlow environment variables
# Copy this file to ".env" and fill in your Supabase project keys.
# The app works fully in LOCAL mode (browser storage) even without these,
# but Friends / Live sharing / Cloud sync / Push need Supabase.
# ─────────────────────────────────────────────────────────────

# From Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (Phase 2) — VAPID public key. Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
